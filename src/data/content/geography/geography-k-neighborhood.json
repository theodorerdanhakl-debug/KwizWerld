  "learn": {
    "steps": [
      {
        "text": "A map is a picture that shows where places are."
      },
      {
        "text": "Your neighborhood has homes, streets, and places people share.",
        "example": "A park, a school, and a store can be on the same map.",
        "image": "neighborhood"
      },
      {
        "text": "Symbols stand for real places. A key tells what the symbols mean."
      },
      {
        "text": "Words like near, far, left, and right help you talk about the map."
      }
    ],
    "check": {
      "prompt": "What does a map key do?",
      "choices": [
        "Tells what the symbols mean",
        "Unlocks a door",
        "Shows only the ocean",
        "Writes your name"
      ],
      "answer": 0,
      "explanation": "The key explains the pictures on the map."
    }
  },

    "steps": [
      {
        "text": "You learn about the world with your five senses."
      },
      {
        "text": "Eyes see, ears hear, and skin feels.",
        "example": "A drum is loud. A stone can feel rough.",
        "image": "senses"
      },
      {
        "text": "Your nose smells, and your tongue tastes."
      },
      {
        "text": "Use more than one sense when you observe. Say what you notice."
      }
    ],
    "check": {
      "prompt": "Which sense do you use to hear a bell?",
      "choices": [
        "Hearing",
        "Taste",
        "Smell",
        "Sight only"

  "learn": {
    "steps": [
      {
        "text": "A cell is the smallest living unit of a living thing."
      },
      {
        "text": "The cell membrane is the outer boundary. It lets some materials in and out.",
        "image": "cell"
      },
      {
        "text": "The nucleus holds the cell's genetic instructions.",
        "example": "Those instructions help the cell make proteins and divide."
      },
      {
        "text": "Plant cells also have a cell wall and chloroplasts. Animal cells do not."
      }
    ],
    "check": {
      "prompt": "What does the nucleus hold?",
      "choices": [

{
  "topicId": "math-5-fractions",
  "subjectId": "math",
  "grade": "5",
  "learn": {
    "steps": [
      {
        "text": "A fraction names equal parts of one whole. The bottom number tells how many equal parts."
      },
      {
        "text": "The top number tells how many of those parts you have.",
        "example": "3/4 means 3 of 4 equal parts.",
        "image": "fraction-bars"
      },
      {
        "text": "If the bottoms match, the larger top is the greater fraction."
      },
      {
        "text": "To add fractions with the same bottom, add the tops and keep the bottom.",
        "example": "1/6 + 4/6 = 5/6"
      }
    ],
    "check": {
      "prompt": "What is 2/7 + 3/7?",
      "choices": [
        "5/7",
        "5/14",
        "6/7",
        "1/7"
      ],
      "answer": 0,
      "explanation": "Add the tops. The bottom stays 7."
    }
  },
  "study": {

  "learn": {
    "steps": [
      {
        "text": "Add the ones first. Then add the tens."
      },
      {
        "text": "Line the digits up by place so ones sit under ones.",
        "example": "24 + 13 = 37",
        "image": "plus-blocks"
      },
      {
        "text": "If the ones make 10 or more, trade 10 ones for 1 ten."
      },
      {
        "text": "Then add the tens, including any ten you traded.",
        "example": "28 + 15: 8 + 5 = 13, so write 3 and add 1 ten. 2 + 1 + 1 = 4. The sum is 43."
      }
    ],
    "check": {
      "prompt": "What is 26 + 13?",
      "choices": [
        "39",
        "29",
        "313",
        "36"
      ],
      "answer": 0,
      "explanation": "6 + 3 = 9 and 2 tens + 1 ten = 3 tens."
    }
  },
